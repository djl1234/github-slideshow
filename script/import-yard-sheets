#!/usr/bin/env node
/**
 * Batch Import Yard Sheet PDFs
 *
 * Usage:
 *   node script/import-yard-sheets [folder-path]
 *
 * If no folder path is provided, defaults to ./yard-sheets/
 *
 * This script:
 *   1. Reads all PDF files from the specified folder
 *   2. Extracts tabular data from each PDF
 *   3. Outputs JSON to stdout (pipe to a file or use in the app)
 *
 * Install dependency first:
 *   npm install pdf-parse
 *
 * Example:
 *   node script/import-yard-sheets "D:\Yard Sheets" > yard-data.json
 *   node script/import-yard-sheets ./yard-sheets/ > yard-data.json
 */

var fs = require('fs');
var path = require('path');

// Try to load pdf-parse
var pdfParse;
try {
    pdfParse = require('pdf-parse');
} catch (e) {
    console.error('Error: pdf-parse module not found.');
    console.error('Install it with: npm install pdf-parse');
    process.exit(1);
}

// --- Configuration ---
var inputFolder = process.argv[2] || path.join(__dirname, '..', 'yard-sheets');

// --- Header patterns (same as browser module) ---
var HEADER_KEYWORDS = ['lot', 'pen', 'dof', 'hd', 'wt', 'date', 'sx', 'ewt', 'sold'];

var FIELD_PATTERNS = {
    trl:         /^trl$/i,
    srt:         /^srt$/i,
    prog:        /^prog$/i,
    fo:          /^fo$/i,
    lotNum:      /^lot$/i,
    pen:         /^pen$/i,
    sfPerHd:     /^sf\/?h/i,
    bunkInPerHd: /^bunk/i,
    sex:         /^sx$/i,
    avgWt:       /^av\s?wt$/i,
    dof:         /^dof$/i,
    dors:        /^dors$/i,
    ewt:         /^ewt$/i,
    dateIn:      /^date\s?in$/i,
    dateOut:     /^date\s?out$/i,
    origHdIn:    /^orig/i,
    sold:        /^sold$/i,
    deadsNo:     /^no$/i,
    deadsPct:    /^%$/i,
    ratn:        /^ratn$/i,
    consNeg1:    /^-1$/i,
    cons7d:      /^7d$/i,
    consYtd:     /^ytd$/i,
    curChgs:     /^cur/i,
    ytdChgs:     /^ytd\s?chg/i,
    customer:    /^cust/i
};

var NUMERIC_FIELDS = [
    'lotNum', 'sfPerHd', 'avgWt', 'dof', 'dors', 'ewt', 'origHdIn',
    'locLot', 'locPen', 'locH', 'locB', 'locR', 'sold', 'deadsNo',
    'bunkInPerHd', 'deadsPct', 'consNeg1', 'cons7d', 'consYtd',
    'curChgs', 'ytdChgs'
];

var INT_FIELDS = [
    'lotNum', 'sfPerHd', 'avgWt', 'dof', 'dors', 'ewt', 'origHdIn',
    'locLot', 'locPen', 'locH', 'locB', 'locR', 'sold', 'deadsNo'
];

// --- Parse text from a PDF ---
function parseYardSheetText(text, sourceFile) {
    var lines = text.split('\n').map(function (l) { return l.trim(); }).filter(function (l) { return l.length > 0; });
    var pens = [];

    // Find header row
    var headerIdx = -1;
    var headerFields = [];

    for (var i = 0; i < Math.min(lines.length, 20); i++) {
        var line = lines[i].toLowerCase();
        var matches = 0;
        HEADER_KEYWORDS.forEach(function (kw) {
            if (line.indexOf(kw) !== -1) matches++;
        });
        if (matches >= 3) {
            headerIdx = i;
            headerFields = identifyColumns(lines[i]);
            break;
        }
    }

    if (headerIdx === -1) {
        // Fallback: try pattern matching on each line
        lines.forEach(function (line) {
            var pen = tryPatternParse(line, sourceFile);
            if (pen && pen.lotNum) pens.push(pen);
        });
        return pens;
    }

    // Parse data rows after header
    for (var j = headerIdx + 1; j < lines.length; j++) {
        var dataLine = lines[j];
        // Skip empty or sub-header lines
        if (!dataLine || dataLine.match(/^[-=]+$/)) continue;
        // Stop at footer lines (totals, etc.)
        if (dataLine.match(/^total/i)) break;

        var pen = parseDataLine(dataLine, headerFields, sourceFile);
        if (pen && pen.lotNum) {
            pens.push(pen);
        }
    }

    return pens;
}

function identifyColumns(headerLine) {
    var parts = headerLine.split(/\s{2,}|\t/);
    var columns = [];
    var lotSeen = false;
    var penSeen = false;

    parts.forEach(function (part, idx) {
        var text = part.trim();
        if (!text) return;

        var field = null;
        Object.keys(FIELD_PATTERNS).forEach(function (f) {
            if (field) return;
            if (FIELD_PATTERNS[f] && FIELD_PATTERNS[f].test(text)) {
                // Handle duplicate Lot/Pen (main vs location)
                if (f === 'lotNum') {
                    field = lotSeen ? 'locLot' : 'lotNum';
                    lotSeen = true;
                } else if (f === 'pen') {
                    field = penSeen ? 'locPen' : 'pen';
                    penSeen = true;
                } else {
                    field = f;
                }
            }
        });

        columns.push({ index: idx, field: field, text: text });
    });

    return columns;
}

function parseDataLine(line, headerFields, sourceFile) {
    var parts = line.split(/\s{2,}|\t/);
    var pen = {
        trl: '', srt: '', prog: '', fo: '',
        lotNum: 0, pen: '', sfPerHd: 0, bunkInPerHd: 0,
        sex: '', avgWt: 0, dof: 0, dors: 0, ewt: 0,
        dateIn: '', dateOut: '',
        origHdIn: 0, locLot: 0, locPen: 0, locH: 0, locB: 0, locR: 0,
        sold: 0, deadsNo: 0, deadsPct: 0, ratn: '',
        consNeg1: 0, cons7d: 0, consYtd: 0,
        curChgs: 0, ytdChgs: 0, customer: '',
        _sourceFile: sourceFile
    };

    headerFields.forEach(function (col) {
        if (!col.field || col.index >= parts.length) return;
        var value = parts[col.index] ? parts[col.index].trim() : '';
        pen[col.field] = convertValue(col.field, value);
    });

    return pen;
}

function convertValue(field, value) {
    if (!value || value === '-' || value === '--') return NUMERIC_FIELDS.indexOf(field) !== -1 ? 0 : '';

    var cleaned = value.replace(/[$,]/g, '').trim();

    if (INT_FIELDS.indexOf(field) !== -1) {
        return parseInt(cleaned, 10) || 0;
    }
    if (NUMERIC_FIELDS.indexOf(field) !== -1) {
        return parseFloat(cleaned) || 0;
    }
    return value;
}

function tryPatternParse(text, sourceFile) {
    var lotMatch = text.match(/\b(\d{5})\b/);
    if (!lotMatch) return null;

    var penMatch = text.match(/\b([A-Z]\d{1,3})\b/);
    var dateMatches = text.match(/\b(\d{1,2}\/\d{1,2}\/\d{4})\b/g);
    var sexMatch = text.match(/\b([OH])\b/);

    if (!penMatch) return null;

    var pen = {
        trl: '', srt: '', prog: '', fo: '',
        lotNum: parseInt(lotMatch[1], 10),
        pen: penMatch ? penMatch[1] : '',
        sfPerHd: 0, bunkInPerHd: 0,
        sex: sexMatch ? sexMatch[1] : '',
        avgWt: 0, dof: 0, dors: 0, ewt: 0,
        dateIn: dateMatches && dateMatches[0] ? dateMatches[0] : '',
        dateOut: dateMatches && dateMatches[1] ? dateMatches[1] : '',
        origHdIn: 0, locLot: 0, locPen: 0, locH: 0, locB: 0, locR: 0,
        sold: 0, deadsNo: 0, deadsPct: 0, ratn: '',
        consNeg1: 0, cons7d: 0, consYtd: 0,
        curChgs: 0, ytdChgs: 0, customer: '',
        _sourceFile: sourceFile
    };

    if (/\bUltra\b/i.test(text)) pen.trl = 'Ultra';
    else if (/\bHR\b/.test(text)) pen.trl = 'HR';

    if (/\bHOL\b/.test(text)) pen.prog = 'HOL';
    else if (/\bDEF\b/.test(text)) pen.prog = 'DEF';

    var custMatch = text.match(/\b([A-Z]{2,}\s+(?:CO|INC|LLC|CORP|LTD|RANCH|FARMS?|CATTLE))\b/i);
    if (custMatch) pen.customer = custMatch[1];

    return pen;
}

// --- Main ---
async function main() {
    // Resolve folder path
    var folder = path.resolve(inputFolder);

    if (!fs.existsSync(folder)) {
        console.error('Error: Folder not found: ' + folder);
        console.error('Usage: node script/import-yard-sheets [folder-path]');
        console.error('Example: node script/import-yard-sheets "D:\\Yard Sheets"');
        process.exit(1);
    }

    // Find all PDF files
    var files = fs.readdirSync(folder).filter(function (f) {
        return f.toLowerCase().endsWith('.pdf');
    });

    if (files.length === 0) {
        console.error('No PDF files found in: ' + folder);
        process.exit(1);
    }

    console.error('Processing ' + files.length + ' PDF file(s) from: ' + folder);

    var allPens = [];
    var errors = [];

    for (var i = 0; i < files.length; i++) {
        var filePath = path.join(folder, files[i]);
        console.error('  Reading: ' + files[i]);

        try {
            var buffer = fs.readFileSync(filePath);
            var data = await pdfParse(buffer);
            var pens = parseYardSheetText(data.text, files[i]);
            console.error('    Found ' + pens.length + ' lot record(s)');
            allPens = allPens.concat(pens);
        } catch (err) {
            console.error('    Error: ' + err.message);
            errors.push({ file: files[i], error: err.message });
        }
    }

    console.error('');
    console.error('Total: ' + allPens.length + ' lot records from ' + files.length + ' files');
    if (errors.length > 0) {
        console.error('Errors: ' + errors.length);
    }

    // Output JSON to stdout
    var output = {
        importDate: new Date().toISOString(),
        sourceFolder: folder,
        fileCount: files.length,
        recordCount: allPens.length,
        errors: errors,
        pens: allPens
    };

    console.log(JSON.stringify(output, null, 2));
}

main().catch(function (err) {
    console.error('Fatal error: ' + err.message);
    process.exit(1);
});
